 python3-ajsonrpc,
 python3-bottle,
 python3-certifi,
 python3-click,
 python3-colorama,
 python3-intelhex,
 python3-marshmallow,
 python3-pyelftools,
 python3-requests,
 python3-rich-click,
 python3-semantic-version,
 python3-serial,
 python3-starlette,
 python3-tabulate,
 python3-uvicorn,
 python3-wsproto,
